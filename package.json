{
  "name": "gable",
  "productName": "Gable",
  "version": "0.1.0",
  "description": "Gable: offline property and expense ledger for real estate projects.",
  "private": true,
  "main": ".vite/build/main.cjs",
  "license": "UNLICENSED",
  "author": "Gable",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "package:mac": "electron-forge package --platform=darwin",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "GABLE_E2E=1 electron-forge package && playwright test",
    "demo:db": "tsx scripts/build-demo-db.ts",
    "dev:demo": "npm run demo:db && GABLE_DATA_DIR=.dev-data/demo electron-forge start"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
